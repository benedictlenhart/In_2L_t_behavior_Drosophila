geom_point(alpha = 0.6, size = 2) +
stat_ellipse(aes(group = inv.st), type = "norm", linetype = "dashed", linewidth = 0.7) +
labs(
x = paste0(pc_x, " (", var_explained[pc_x], "% variance)"),
y = paste0(pc_y, " (", var_explained[pc_y], "% variance)"),
color = "Inversion genotype",
title = paste0("PCA: ", pc_x, " vs ", pc_y)
) +
theme_classic() +
theme(legend.position = "right")
