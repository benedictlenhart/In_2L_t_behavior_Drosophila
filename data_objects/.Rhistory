library(lme4)
library(lmerTest)
library(data.table)
library(tidyverse)
# Step 1: Pivot otherphenotypes wide (4 phenotypes)
other_wide <- dcast(
otherphenotypes,
flyid + temp + inv.st + sex + stimili + f1_In3RP + f1_In3RK + f1_In3RMo ~ phenotype,
value.var = "Value"
)
head(other_wide)
# Step 2: Extract region 1 and region 8 from feeddata
feed_wide <- dcast(
feeddata[region %in% c(1, 8)],
flyid + temp ~ region,
value.var = "region.prop"
)
head(feed_wide)
setnames(feed_wide, c("1", "8"), c("FeedRegion1", "FeedRegion8"))
# Step 3: Join on flyid + temp
combined <- other_wide[feed_wide, on = c("flyid", "temp"), nomatch = NA]
feed_wide$temp = as.factor(feed_wide$temp)
# Step 3: Join on flyid + temp
combined <- other_wide[feed_wide, on = c("flyid", "temp"), nomatch = NA]
head(combined)
# Step 4: Check
head(combined)
dim(combined)
phenotype_cols <- c("SleepDuration", "duration", "Magnitude", "Activity", "FeedRegion1", "FeedRegion8")
pca_matrix <- combined[, ..phenotype_cols]
head(pca_matri)
head(pca_matrix)
# Check missingness before dropping
colSums(is.na(pca_matrix))
# Remove incomplete cases
pca_matrix_complete <- na.omit(pca_matrix)
#for now, only females at 25
small = combined %>%
filter(sex == "female",
temp == 25)
pca_matrix <- small[, ..phenotype_cols]
# Check missingness before dropping
colSums(is.na(pca_matrix))
View(pca_matrix)
# Remove incomplete cases
pca_matrix_complete <- na.omit(pca_matrix)
# Run PCA
pca_result <- prcomp(pca_matrix_complete, scale. = TRUE, center = TRUE)
summary(pca_result)
biplot(pca_result)
pca_result
# Get which rows survived na.omit (to match metadata back)
complete_rows <- which(complete.cases(combined[, ..phenotype_cols]))
# Build a plotting data frame with PC scores + metadata
pca_df <- data.table(
pca_result$x,  # PC scores
combined[complete_rows, .(flyid, temp, sex, inv.st, f1_In3RP, f1_In3RK, f1_In3RMo)]
)
# Add a row index to combined before any filtering
combined[, row_id := .I]
# Subset combined to complete cases on phenotype columns, keeping row_id
combined_complete <- combined[complete.cases(combined[, ..phenotype_cols])]
# Get which rows survived na.omit (to match metadata back)
complete_rows <- which(complete.cases(small[, ..phenotype_cols]))
# Build a plotting data frame with PC scores + metadata
pca_df <- data.table(
pca_result$x,  # PC scores
small[complete_rows, .(flyid, temp, sex, inv.st, f1_In3RP, f1_In3RK, f1_In3RMo)]
)
pca_df
ggplot(pca_df, aes(x = .data[[pc_x]], y = .data[[pc_y]], color = inv.st)) +
geom_point(alpha = 0.6, size = 2) +
stat_ellipse(aes(group = inv.st), type = "norm", linetype = "dashed", linewidth = 0.7) +
facet_wrap(~ sex) +   # or ~ temp, or ~ sex + temp
labs(
x = paste0(pc_x, " (", var_explained[pc_x], "% variance)"),
y = paste0(pc_y, " (", var_explained[pc_y], "% variance)"),
color = "Inversion genotype"
) +
theme_classic()
